+// LDN discovery also allows the inbox in a Link header (https://www.w3.org/TR/ldn/#discovery),
+// as a server writes it from the resource's description (e.g. CSS's .meta)
+function getDocumentInboxFromLinkHeader() {
+  const linkHeaders = Config.Resource?.[Config.DocumentURL]?.headers?.linkHeaders;
+  if (!linkHeaders?.has('rel', ns.ldp.inbox.value)) return;
+  return sanitizeIRI(linkHeaders.rel(ns.ldp.inbox.value)[0].uri);
+}
